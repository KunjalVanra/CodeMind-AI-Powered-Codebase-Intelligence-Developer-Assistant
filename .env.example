# Copy this file to the project root as .env only if one does not already exist.
# Replace both password placeholders and the JWT placeholder before starting Compose.

APP_NAME=CodeMind
DEBUG=false

# Compose uses these values to initialize MySQL and connect the backend.
MYSQL_DATABASE=codemind_db
MYSQL_USER=codemind
MYSQL_PASSWORD=replace-with-a-strong-application-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Generate a unique random value; never commit the real value.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional. AI documentation, test generation, and Q&A require a valid key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Comma-separated browser origins. Include the actual host and port used.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5181,http://127.0.0.1:5181

# Published frontend port. The Vite value is baked into the image at build time.
FRONTEND_PORT=8080
VITE_API_BASE_URL=
